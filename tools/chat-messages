#!/usr/bin/env bash

show_help() {
    cat <<'EOF'
chat-messages - render a Claude Code transcript (JSONL) as readable messages

Usage:
  chat-messages [options] [FILE]
  chat-messages                       # no FILE in a terminal -> interactive picker
  cat FILE | chat-messages [options]
  tail -f FILE | chat-messages [options]

Options:
  -p, --pick            Browse transcripts with an fzf picker, then render the pick
  -j, --json            Output messages as JSON (one object per line)
  -md, --markdown       Output messages as Markdown
  --raw                 Default mode: never markdown-render bodies (plain text)
  -u, --user NAME       Display name for user messages (default: User)
  -a, --assistant NAME  Display name for assistant messages (default: Assistant)
  -h, --help            Show this help

FILE may be a transcript path or a bare Claude session UUID (resolved under
~/.claude/projects). With no FILE and an interactive terminal, an fzf picker
lists every transcript newest-first so you can fuzzy-search and preview one;
force it anywhere with --pick. Piping into stdin bypasses the picker.

Default output is colored terminal text; when stdout is a TTY and `mdcat` is
installed, message bodies are markdown-rendered per message (works while
tailing, unlike `--md | mdcat`). Use --raw to disable.
EOF
}

JSON=0
JSON_ARR=0
MARKDOWN=0
RAW=0
LIMIT=1000

USER_NAME="User"
ASSISTANT_NAME="Assistant"

transcript_file_path_from_session_id() {
    local uuid_regex='^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$'
    input=${1:-}
    if [ -z "$input" ]; then
        input=$(cat)
    fi

    if [ -z "$input" ]; then
        echo "$input"
        return 1
    fi
    if [[ "$input" =~ $uuid_regex ]]; then
        file=$(find ~/.claude/projects/ -name "$input.jsonl" | head -1)

        if [ -s "$file" ]; then
            echo "$file"
            return 0
        fi
    fi

    echo "$input"
    return 1
}

# Turn an encoded project directory name into a short, human label.
# Claude stores transcripts under ~/.claude/projects/<dir>, where <dir> is the
# project's absolute path with every "/" rewritten to "-". That rewrite is not
# reversible (real dashes in names are indistinguishable), so we do not try to
# reconstruct the path — we just drop the "-Users-<login>-" home prefix and keep
# the trailing few segments, which is what actually identifies the project.
project_label_from_dir() {
    local dir="$1"
    dir="${dir#-}"                       # leading dash from the leading slash
    dir="${dir#Users-}"                  # /Users
    dir="${dir#"$(id -un)"-}"            # the login name segment
    # Collapse to the last three segments so long paths stay readable.
    awk -F- '{ n=NF; s=(n>3?n-2:1); out=""; for(i=s;i<=n;i++) out=out (out==""?"":"/") $i; print out }' <<<"$dir"
}

# Emit one fzf row per transcript. A row is "<display>\t<path>": fzf shows and
# searches the display half (via --with-nth=1) and we recover the path from the
# tab-delimited tail on accept. Rows are streamed in caller order so fzf renders
# them immediately instead of blocking on a full scan of every file.
transcript_rows() {
    local f dir proj sess mtime summary
    while IFS= read -r f; do
        [ -s "$f" ] || continue
        dir=$(basename "$(dirname "$f")")
        proj=$(project_label_from_dir "$dir")
        sess=$(basename "$f" .jsonl)
        # %m is epoch seconds on BSD/macOS stat; format it locally for display.
        mtime=$(stat -f '%Sm' -t '%m/%d %H:%M' "$f" 2>/dev/null)
        # First human-authored user text: skip slash-command/caveat/reminder
        # envelopes (all wrapped in "<...>") and blank turns. Reading only the
        # head keeps this fast across hundreds of multi-megabyte transcripts.
        summary=$(head -n 60 "$f" 2>/dev/null | jq -r '
            select(.type=="user")
            | .message.content
            | (if type=="string" then . else ([.[]? | select(.type=="text") | .text] | join(" ")) end)
            | select(. != null and (ltrimstr(" ") | startswith("<") | not))
            | gsub("\\s+"; " ") | ltrimstr(" ")
            | select(length > 0)
        ' 2>/dev/null | head -n 1)
        summary=${summary:0:200}
        [ -n "$summary" ] || summary="(no user text)"
        printf '%s  %-24s  %s  %s\t%s\n' "$mtime" "$proj" "${sess:0:8}" "$summary" "$f"
    done
}

# Interactive transcript chooser. Prints the selected transcript path on stdout
# and returns non-zero when fzf is unavailable or the user cancels, so callers
# can exit quietly. The preview pane renders the highlighted transcript through
# this very script (--plain for speed: no per-message mdcat pass).
pick_transcript() {
    if ! command -v fzf >/dev/null 2>&1; then
        echo "Error: --pick needs fzf (brew install fzf)" >&2
        return 2
    fi
    local self selected
    self=$(command -v chat-messages || echo "$0")
    # Newest-first: stat every transcript once, sort by epoch mtime descending,
    # then hand the ordered paths to the row generator. fzf preserves input order.
    selected=$(
        find "$HOME/.claude/projects/" -name '*.jsonl' -type f 2>/dev/null \
            | while IFS= read -r f; do stat -f '%m %N' "$f" 2>/dev/null; done \
            | sort -rn | cut -d' ' -f2- \
            | transcript_rows \
            | fzf --ansi --delimiter=$'\t' --with-nth=1 \
                  --no-hscroll --layout=reverse --border \
                  --prompt='transcript> ' \
                  --header='enter: render   ctrl-/: toggle preview' \
                  --preview="$self --plain {2}" \
                  --preview-window='right,55%,wrap' \
                  --bind='ctrl-/:toggle-preview'
    )
    [ -n "$selected" ] || return 1          # user cancelled (Esc / Ctrl-C)
    printf '%s\n' "${selected##*$'\t'}"
}

PICK=0

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            show_help
            exit 0
            ;;
        -p|--pick)
            PICK=1
            shift 1
            ;;
        -j|--json)
            JSON=1
            JSON_ARR=0
            MARKDOWN=0
            shift 1
            ;;
        --json-array)
            JSON=1
            JSON_ARR=1
            MARKDOWN=0
            shift 1
            ;;
        -md|--markdown|--md)
            JSON=0
            MARKDOWN=1
            shift 1
            ;;
        -u|--user)
            USER_NAME="$2"
            shift 2
            ;;
        -a|--assistant)
            ASSISTANT_NAME="$2"
            shift 2
            ;;
        -l|--limit)
            LIMIT="$2"
            shift 2
            ;;
        --plain)
            RAW=1
            shift 1
            ;;
        --)
            shift
            break
            ;;
        -*)
            echo "Error: unknown option: $1" >&2
            show_help >&2
            exit 1
            ;;
        *)
            TARGET="$1"
            if [ -z "$TARGET" ]; then
                show_help >&2
                exit 1
            fi
            
            TARGET=$(transcript_file_path_from_session_id "$TARGET")
            if ! [ -e "$TARGET" ]; then
                echo "Error: path not found: $TARGET" >&2
                exit 1
            fi

            shift
            ;;
    esac
done

# Launch the picker when asked (--pick), or by default when there is no FILE and
# stdin is an interactive terminal — i.e. bare `chat-messages` in a shell. When
# stdin is a pipe (no TTY) we fall through to reading it, preserving the
# `cat FILE | chat-messages` and `tail -f` workflows.
if [[ $PICK -eq 1 ]] || { [ -z "${TARGET:-}" ] && [ -t 0 ]; }; then
    TARGET=$(pick_transcript)
    pick_rc=$?
    # 1 = user cancelled (quiet exit 0), 2 = fzf missing (its own error already
    # printed). Anything non-zero means "no selection": stop before rendering.
    if [ $pick_rc -ne 0 ]; then
        [ $pick_rc -eq 1 ] && exit 0
        exit $pick_rc
    fi
fi

TARGET="${TARGET:-/dev/stdin}"

hr() {
    printf "$(tput dim)$(tput setaf 7)%.0s─" $(seq 1 "$(tput cols)") && tput sgr0
}

# Per-object transform: emit one {role,message,timestamp} per matching line,
# or `empty` to skip. No map()/slurp, so jq streams line-by-line (tail -f).
# shellcheck disable=SC2016
extract='
    def fmt_ts: split(".")[0] + "Z" | fromdateiso8601 | strflocaltime("%m/%d/%Y %I:%M:%S %p");

    # if this has already been processed by us, do nothing
    if .role? != null then 
        . 
    else
        # get messages with content
        (
            select(.message?.content != null) | 
            (    
                # if the message content is a string, this is a user message
                if (.message.content | type == "string") then
                    # usermessage format
                    {role: $user, message: .message.content, timestamp: .timestamp | fmt_ts}
                # if the messaged content is an array, it is most likely an assistant response
                elif (.message.content | type == "array") then
                    # create the base assistant return object
                        {role: $assistant, timestamp: .timestamp | fmt_ts} + 
                        (
                        # take the array of content and filter just thinking and text entries
                        .message.content | map(select(
                            (.type == "text" and .text != null) or 
                            (.type == "thinking" and .thinking != null) 
                        ))
                        | 
                        # if message text
                        (if map(select(.text != null)) | length > 0 then
                            # build message object
                            {"message": map(.text // "") | join("\n")}
                        # else ifif thinking
                        elif map(select(.thinking != null)) | length > 0 then
                            #build thinking
                            {"thinking": map(.thinking // "") | join("\n")}
                        else null
                        end)
                        )
                end
            ) |
            if (.message // .thinking != null) then . else empty end
        )
    end
'

# Read the TARGET and check if it's a file path 
read_input() {
    output="$(cat "$TARGET" | transcript_file_path_from_session_id)"
    ([ -s "$output" ] && cat "$output" || echo "$output")
}

render_ansi_color_view() {
    # Colored, compact header line: "[timestamp] Role".
    # shellcheck disable=SC2016
    header='
    { blue: "\u001b[94m", green: "\u001b[92m", bright_green: "\u001b[92m", reset: "\u001b[0m" } as $c
    | "\(if .role == $user then $c.blue else $c.green end)[\(.timestamp)] \(.role)\($c.reset)"
    '

    read_input \
        | jq -j --unbuffered --arg user "$USER_NAME" --arg assistant "$ASSISTANT_NAME" "$extract | ($header) + \"\u001f\" + \"> **\`Thinking\`** \(.thinking // empty)\" + \"\u001f\" + .message + \"\u0000\"" \
        | while IFS= read -r -d '' rec; do
            printf '%s\n' "${rec%%$'\x1f'*}"
            if command -v mdcat >/dev/null 2>&1; then
                printf '%s' "${rec#*$'\x1f'}" | mdcat
            else
                printf '%s' "${rec#*$'\x1f'}"
            fi
            hr
            printf '\n'
        done
}

# Plain per-object formatter (no external renderer), selected by mode.
if [[ $JSON -eq 1 ]]; then
    fmt='tojson'
elif [[ $MARKDOWN -eq 1 ]]; then 
    fmt='"\n\(.role) - \(.timestamp)\n====\n\(.message // "**Thinking:**\n > \(.thinking)")\n***"'
elif [[ $RAW -eq 0 && -t 1  ]]; then 
    # render each message body as markdown via mdcat --
    # but only when stdout is a TTY, mdcat exists, and --raw was not passed. mdcat
    # buffers to EOF, so it can't wrap the whole `tail -f` stream at once; we run
    # it per message instead, keeping BOTH markdown rendering AND streaming.
    render_ansi_color_view
    exit 0
else # Plain text
    fmt='"[\(.timestamp)] \(.role) \(if .thinking != null then "Thoughts" else "Message" end)\n\(.message // .thinking)\n"'
fi

# One long-lived jq; --unbuffered flushes per object so that
# `tail -f FILE | chat-messages` prints messages as they are appended.
output=$(read_input | jq -r --unbuffered --arg user "$USER_NAME" --arg assistant "$ASSISTANT_NAME" "$extract | ($fmt)")
if [[ $JSON -eq 1 && $JSON_ARR -eq 1 ]]; then
    echo "$output" | jq -src 
else
    echo "$output"
fi
