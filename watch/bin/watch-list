#!/usr/bin/env bash
# watch-list — list all persisted watch state dirs with metadata.
#
# Usage:
#   watch-list              # table of all watches
#   watch-list --json       # one JSON object per line
#
set -uo pipefail

# Resolve our own dir (symlink-safe) so sourcing works from any cwd / PATH.
src="${BASH_SOURCE[0]}"
while [ -h "$src" ]; do
  dir=$(cd -P "$(dirname "$src")" && pwd)
  src=$(readlink "$src")
  [[ "$src" != /* ]] && src="$dir/$src"
done
SCRIPT_DIR=$(cd -P "$(dirname "$src")" && pwd)

# shellcheck source=../lib/env.sh
source "$SCRIPT_DIR/../lib/env.sh"
watch_init_data_root

root="${WATCH_DATA_ROOT}"
if [ ! -d "$root" ]; then
  echo "no watches" >&2
  exit 0
fi

mode="table"
if [ "${1:-}" = "--json" ]; then
  mode="json"
fi

found=0
for dir in "$root"/*/; do
  [ -d "$dir" ] || continue
  meta="$dir/_meta.json"
  [ -f "$meta" ] || continue
  found=1
  if [ "$mode" = "json" ]; then
    cat "$meta"
    echo
  else
    id=$(jq -r '.id' "$meta")
    child=$(jq -r '.child' "$meta")
    args=$(jq -r '.args | join(" ")' "$meta")
    interval=$(jq -r '.interval' "$meta")
    started=$(jq -r '.last_started' "$meta")
    printf '%-40s  every %4ss  last-run %s\n  %s %s\n\n' \
      "$id" "$interval" "$started" "$child" "$args"
  fi
done

if [ "$found" -eq 0 ] && [ "$mode" = "table" ]; then
  echo "no watches"
fi
